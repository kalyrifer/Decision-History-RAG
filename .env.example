# ===== Decision History RAG — настройка окружения =====
# Скопируй в .env:  copy .env.example .env  (PowerShell)
# .env НЕ попадает в git (см. .gitignore).

# --- Обязательно для ответов LLM (синтез нарратива) ---
# OpenRouter: зарегистрируйся на openrouter.ai → Keys → создай ключ.
# Бесплатные модели с суффиксом :free. Без этого ключа работает только
# поиск (search), а ask/UI без ответа LLM — нет.
OPENROUTER_API_KEY=

# --- Нужно ТОЛЬКО для загрузки данных (Фаза 1, ingest) ---
# GitHub Personal Access Token (read-only достаточно, публичный доступ):
# GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic).
# Если данные уже загружены в Postgres и ты не собираешься перезагружать —
# токен не нужен.
GITHUB_TOKEN=

# --- Не используются в текущем стеке (оставлены для совместимости) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Подключение к Postgres + pgvector (см. docker-compose.yml) ---
# Порт 5433 маппится на 5432 внутри контейнера.
PG_DSN=postgresql://rag:rag@localhost:5433/decision_rag
